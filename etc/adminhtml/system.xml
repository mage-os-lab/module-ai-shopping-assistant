<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="ai_integration" translate="label" type="text" sortOrder="900" showInDefault="1"
                 showInWebsite="1" showInStore="1">
            <tab>service</tab>
            <label>AI Integration</label>
            <resource>Magento_Backend::ai_integration</resource>
            <group id="aiagent" translate="label" type="text" sortOrder="20" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <label>Shopping Assistant</label>
                <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>General</label>
                    <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Turns the assistant on for this store view.</comment>
                    </field>
                    <field id="surface_mode" translate="label comment" type="select" sortOrder="20" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Surface Mode</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\SurfaceMode</source_model>
                        <comment>Hyvä only. Cart docks the assistant into the Hyvä cart drawer. Overlay opens a panel of
                            its own on the right side of the page. Luma based themes always use the panel.
                        </comment>
                    </field>
                    <field id="launcher_enabled" translate="label comment" type="select" sortOrder="30"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Launcher</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Round button bottom right on every page. With No, the assistant opens only from the
                            product page block, the cart page box and, in Cart mode, the header cart icon.
                        </comment>
                    </field>
                    <field id="keep_open" translate="label comment" type="select" sortOrder="35" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Keep Open Across Pages</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Reopens the overlay panel and the Luma panel on the next page when the shopper left it
                            open. Hyvä Cart mode and phones keep it closed.
                        </comment>
                    </field>
                    <field id="product_block_enabled" translate="label comment" type="select" sortOrder="40"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Product Page Block</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>"Ask about this product" on the product page.</comment>
                    </field>
                    <field id="header_icon_view" translate="label comment" type="select" sortOrder="50"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Header Icon View</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\HeaderIconView</source_model>
                        <comment>Hyvä Cart mode only. What the drawer opens with when the customer clicks the header
                            cart icon: the cart, the chat, or whichever of the two they used last.
                        </comment>
                        <depends>
                            <field id="surface_mode">side_cart</field>
                        </depends>
                    </field>
                    <field id="streaming" translate="label comment" type="select" sortOrder="60" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Streaming Replies</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\Streaming</source_model>
                        <comment>Auto shows each reply word by word while the model writes it. Set Off when a proxy,
                            CDN or firewall in front of the store holds responses back until they are complete:
                            the customer then sees the whole reply at once instead of a blank panel.
                        </comment>
                    </field>
                </group>
                <group id="model" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Model</label>
                    <field id="ai_service" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>AI Service</label>
                        <source_model>MageOS\AiBase\Model\Config\Source\ConfiguredServiceWithAutomatic</source_model>
                        <comment>Configure services under Stores &gt; Configuration &gt; Mage-OS &gt; AI Configuration. Automatic uses the first usable one.</comment>
                    </field>
                    <field id="model_id" translate="label comment" type="text" sortOrder="20" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Model Override</label>
                        <comment>Leave empty to use the model of the AI service. A name here must be valid for that provider.</comment>
                    </field>
                    <field id="max_tokens" translate="label comment" type="text" sortOrder="30" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Max Tokens</label>
                        <validate>validate-digits</validate>
                        <comment>Bounds thinking and reply together.</comment>
                    </field>
                    <field id="thinking_effort" translate="label comment" type="select" sortOrder="40"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Reasoning Effort</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\ThinkingEffort</source_model>
                        <comment>Translated per provider by AI Base. Off turns reasoning off where the provider allows it.</comment>
                    </field>
                    <field id="progress_updates" translate="label comment" type="select" sortOrder="50"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Show Progress Notes</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Shows the customer the short notes the model writes between lookups, above the cards. Sends thinking display "updates" with its beta flag, which only some models accept: leave this off for any other model, or every turn fails. Needs Reasoning Effort above Off.</comment>
                    </field>
                </group>
                <group id="voice" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Voice</label>
                    <field id="brand_name" translate="label comment" type="text" sortOrder="10" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Brand Name</label>
                        <comment>How the assistant names the store.</comment>
                    </field>
                    <field id="assistant_name" translate="label comment" type="text" sortOrder="20" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Assistant Name</label>
                        <comment>Shown in the header of the panel and used in the prompt.</comment>
                    </field>
                    <field id="brand_voice" translate="label comment" type="text" sortOrder="30" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Brand Voice</label>
                        <comment>Completes the sentence "Your voice is ..." in the prompt. Two to six adjectives or a short
                            clause. Examples: "warm, concise, and plain about trade-offs", "expert and direct, like
                            a good shop assistant, never salesy", "playful, but precise about sizes and materials".
                        </comment>
                    </field>
                    <field id="greeting" translate="label comment" type="textarea" sortOrder="40" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Greeting</label>
                        <comment>First line in the panel.</comment>
                    </field>
                    <field id="starters" translate="label comment" type="textarea" sortOrder="50" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Starter Prompts</label>
                        <backend_model>MageOS\AiShoppingAssistant\Model\Config\Backend\Lines</backend_model>
                        <comment>One starter prompt per line; the first five are shown.</comment>
                    </field>
                    <field id="domain_search_notes" translate="label comment" type="textarea" sortOrder="60"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Search Hints</label>
                        <comment>One line added to the prompt's search rules for this catalog's vocabulary. Example:
                            "Customers say hoodie for sweatshirt. Sizes are US. Searching by fabric works better
                            than by activity."
                        </comment>
                    </field>
                </group>
                <group id="content" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Content</label>
                    <field id="policy_pages" translate="label comment" type="multiselect" sortOrder="10"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Policy Pages</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\CmsPages</source_model>
                        <can_be_empty>1</can_be_empty>
                        <comment>CMS pages the assistant may quote for terms and policies. Empty turns the policy
                            tool off.
                        </comment>
                    </field>
                    <field id="allowed_categories" translate="label comment" type="multiselect" sortOrder="20"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Allowed Categories</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\CategoryTree</source_model>
                        <comment>When set, search and product details are limited to these categories.</comment>
                    </field>
                    <field id="catalog_map_depth" translate="label comment" type="select" sortOrder="21"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Catalog Map Depth</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\CatalogMapDepth</source_model>
                        <comment>The catalog map is the store's category tree printed into the system prompt, so
                            the assistant knows which departments exist and can list any of them by id. Depth is
                            how many levels below each root are printed. Off removes the map.
                        </comment>
                    </field>
                    <field id="catalog_map_roots" translate="label comment" type="multiselect" sortOrder="22"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Catalog Map Roots</label>
                        <source_model>MageOS\AiShoppingAssistant\Model\Config\Source\CategoryTree</source_model>
                        <can_be_empty>1</can_be_empty>
                        <comment>Top categories the map starts from. Empty means every active category in the
                            main menu.
                        </comment>
                    </field>
                    <field id="catalog_map_max_chars" translate="label comment" type="text" sortOrder="23"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Catalog Map Max Characters</label>
                        <validate>validate-digits</validate>
                        <comment>Cap on the map text in the prompt. A longer map is cut and the assistant uses category
                            search instead.
                        </comment>
                    </field>
                    <field id="store_facts" translate="label comment" type="text" sortOrder="24"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Store Facts</label>
                        <frontend_model>MageOS\AiShoppingAssistant\Block\Adminhtml\Form\Field\StoreFacts</frontend_model>
                        <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                        <comment>Each row is a service or term the assistant may answer about. Topic names it.
                            Keywords are the customer words that trigger it, comma separated; leave them empty to
                            match on the topic words. Source: a text answer, a CMS page or block (enter its
                            identifier), or Not offered. Long content belongs in a CMS page or block; keep text
                            answers to two sentences.
                        </comment>
                    </field>
                    <field id="include_core_facts" translate="label comment" type="select" sortOrder="25"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Include Core Facts</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Facts the assistant reads from Magento settings by itself: enabled payment
                            methods, shipping carriers, whether a gift message can be added at checkout, guest
                            checkout, minimum order amount, store contact. Store Facts above cover what Magento
                            does not know, for example gift wrapping.
                        </comment>
                    </field>
                </group>
                <group id="cards" translate="label" type="text" sortOrder="45" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Product Cards</label>
                    <comment>Which parts of a product card the assistant renders.</comment>
                    <field id="products_image" translate="label" type="select" sortOrder="10" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Show image</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="products_price" translate="label" type="select" sortOrder="20" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Show price</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="products_description" translate="label" type="select" sortOrder="30" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Show short description</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="products_stock" translate="label" type="select" sortOrder="40" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Show stock status</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="products_add_to_cart" translate="label" type="select" sortOrder="50" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Show Add to cart button</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="products_reason" translate="label" type="select" sortOrder="60" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Show the assistant's reason</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                </group>
                <group id="limits" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Limits</label>
                    <field id="concurrent_turns" translate="label comment" type="text" sortOrder="10"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Concurrent Turns</label>
                        <validate>validate-digits</validate>
                        <comment>Turns running at once per store view. Each turn holds one PHP worker.</comment>
                    </field>
                    <field id="turns_per_session" translate="label comment" type="text" sortOrder="20"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Turns Per Session</label>
                        <validate>validate-digits</validate>
                        <comment>Lifetime cap.</comment>
                    </field>
                    <field id="turns_per_session_window" translate="label comment" type="text" sortOrder="30"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Turns Per Session Window</label>
                        <validate>validate-digits</validate>
                        <comment>Cap per 10 minutes.</comment>
                    </field>
                    <field id="turns_per_ip_minute" translate="label comment" type="text" sortOrder="40"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Turns Per IP Per Minute</label>
                        <validate>validate-digits</validate>
                        <comment>Per client address.</comment>
                    </field>
                    <field id="max_tool_iterations" translate="label comment" type="text" sortOrder="50"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Max Tool Iterations</label>
                        <validate>validate-digits</validate>
                        <comment>Model rounds per turn; the last one is forced tool-less.</comment>
                    </field>
                    <field id="max_quantity_per_item" translate="label comment" type="text" sortOrder="60"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Max Quantity Per Item</label>
                        <validate>validate-digits</validate>
                        <comment>Cart caps enforced by the gates.</comment>
                    </field>
                    <field id="max_cart_lines" translate="label comment" type="text" sortOrder="70" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Max Cart Lines</label>
                        <validate>validate-digits</validate>
                        <comment>Cart caps enforced by the gates.</comment>
                    </field>
                    <field id="max_message_length" translate="label comment" type="text" sortOrder="80"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Max Message Length</label>
                        <validate>validate-digits</validate>
                        <comment>Characters per customer message.</comment>
                    </field>
                    <field id="turn_wall_clock" translate="label comment" type="text" sortOrder="90"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Turn Wall Clock</label>
                        <validate>validate-digits</validate>
                        <comment>Seconds one reply may keep calling tools. When the clock runs out the assistant answers
                            with what it has instead of starting another round. A running turn holds one PHP
                            worker for its whole length.
                        </comment>
                    </field>
                    <field id="max_search_results" translate="label comment" type="text" sortOrder="100"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Max Search Results</label>
                        <validate>validate-digits</validate>
                        <comment>Result ceiling.</comment>
                    </field>
                    <field id="max_fenced_chars" translate="label comment" type="text" sortOrder="110"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Max Fenced Characters</label>
                        <validate>validate-digits</validate>
                        <comment>Characters per fenced tool result.</comment>
                    </field>
                    <field id="compact_above_tokens" translate="label comment" type="text" sortOrder="120"
                           showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Compact Above Tokens</label>
                        <validate>validate-digits</validate>
                        <comment>Prompt size that triggers compaction.</comment>
                    </field>
                </group>
                <group id="privacy" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Privacy</label>
                    <field id="retention_days" translate="label comment" type="text" sortOrder="10" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Retention Days</label>
                        <validate>validate-digits</validate>
                        <comment>Sessions and transcripts older than this are deleted nightly.</comment>
                    </field>
                    <field id="show_ai_label" translate="label comment" type="select" sortOrder="20" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Show AI Label</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Shows the AI badge next to the assistant name and the "AI assistant" line under the
                            message box, so customers know they talk to software.
                        </comment>
                    </field>
                    <field id="contact_url" translate="label comment" type="text" sortOrder="30" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Contact URL</label>
                        <comment>Link added to the "AI assistant" line as "Need a person? Contact us". Empty hides
                            the link.
                        </comment>
                    </field>
                    <field id="contact_label" translate="label comment" type="text" sortOrder="40" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Contact Label</label>
                        <comment>Text of that link.</comment>
                    </field>
                    <field id="debug_log" translate="label comment" type="select" sortOrder="50" showInDefault="1"
                           showInWebsite="1" showInStore="1">
                        <label>Debug Log</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Logs request and response bodies. They contain the cart and the profile; keep off
                            in production.
                        </comment>
                    </field>
                </group>
            </group>
        </section>
    </system>
</config>
